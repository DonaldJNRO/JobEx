{
  "name": "sabie-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'next lint was removed in Next 16 and there is no ESLint config here. Use: npm run verify' && exit 1",
    "check:tokens": "node scripts/token-collision-check.mjs",
    "test": "for f in src/lib/*.test.mjs; do printf \"\\n— %s\\n\" \"$f\"; tsx \"$f\" || exit 1; done",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run check:tokens"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "firebase": "^12.11.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
